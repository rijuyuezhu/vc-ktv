{
  "name": "vc-ktv-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint static tests",
    "format": "prettier --write \"static/*.js\" \"tests/*.cjs\" eslint.config.mjs package.json",
    "format:check": "prettier --check \"static/*.js\" \"tests/*.cjs\" eslint.config.mjs package.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "3.9.10"
  }
}
